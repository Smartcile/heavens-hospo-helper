generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum CompletionType {
  TICK
  TICK_NOTE
  TICK_PHOTO
}

enum ScheduleType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum TimeOffStatus {
  PENDING
  APPROVED
  DECLINED
}

enum NoticePriority {
  INFO
  IMPORTANT
  URGENT
}

enum CalendarSource {
  GOOGLE
  ICAL
  MANUAL
}

enum BookingStatus {
  CONFIRMED
  PENDING
  CANCELLED
  SEATED
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  ONLINE
  PHONE
  WALK_IN
  WOOCOMMERCE
}

// A knowledge resource's type. TRAINING is a sign-off-able guide; the rest are
// reference material that bundles alongside tasks in a section.
enum ResourceKind {
  TRAINING
  SOP
  FAQ
  HOWTO
}

// What a guide or pathway is targeted at. Polymorphic so one "APPLIES TO"
// control covers all three, and a guide can hit several at once (a food-safety
// SOP belongs to Kitchen *and* Bar).
enum AudienceKind {
  DEPARTMENT
  SECTION
  POSITION
}

enum GuideStatus {
  DRAFT
  PUBLISHED
}

enum FollowUpKind {
  MISSED // a due task wasn't completed
  UNTRAINED // a task was completed by someone without the required training
  INCORRECT // a manager flagged work as not done correctly
}

enum FollowUpStatus {
  OPEN
  RESOLVED
}

// P&L budget line kinds. GROUP = header with children, LINE = a dollar line,
// TOTAL = sums its children (amount never stored — computed at read time).
enum BudgetLineKind {
  GROUP
  LINE
  TOTAL
}

model Venue {
  id                     String    @id @default(uuid())
  name                   String
  address                String?
  timezone               String    @default("Pacific/Auckland")
  isActive               Boolean   @default(true)
  isDemo                 Boolean   @default(false) // seeded demo venue — read-only for non-admins, excluded from syncs
  sharingEnabled         Boolean   @default(false) // venue can share/receive staff, products, and WooCommerce data
  sharedWooVenueId       String? // source venue for WooCommerce sync (source-venue model)
  sharedWooVenue         Venue?    @relation("SharedWooVenue", fields: [sharedWooVenueId], references: [id])
  wooSourceFor           Venue[]   @relation("SharedWooVenue")
  autoSeat               Boolean   @default(false) // Woo order auto-seating (off by default — seat manually)
  // External embeds (pasteable links shown live in the app)
  loadedRosterUrl        String?
  googleCalendarUrl      String? // also imported into the planner via its derived iCal feed
  icalFeedUrl            String? // any .ics subscribe link (e.g. a Loaded/roster calendar feed) — imported
  externalRefreshMinutes Int       @default(0) // 0 = manual refresh only
  lastExternalSyncAt     DateTime? // last successful calendar import
  // Geo-fence for timeclock punches (centre point + allowed radius in metres).
  // Null means geo-fencing is off for this venue.
  geoLat                 Float?
  geoLon                 Float?
  geoRadius              Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  departments         Department[]
  staff               Staff[]
  tasks               Task[]
  qrCodes             QRCode[]
  budgetPeriods       BudgetPeriod[]
  trainingModules     TrainingModule[]
  guides              Guide[]
  taskTemplates       TaskTemplate[]
  shiftNotes          ShiftNote[]
  shifts              Shift[]
  timeOffRequests     TimeOffRequest[]
  notices             Notice[]
  calendarEvents      CalendarEvent[]
  sections            Section[]
  followUps           FollowUp[]
  checklists          Checklist[]
  floorPlans          FloorPlan[]
  inventoryCategories InventoryCategory[]
  inventoryItems      InventoryItem[]
  paletteDefaults     PaletteDefault[]
  tableProfiles       TableProfile[]
  stocktakeRecords    StocktakeRecord[]
  suppliers           Supplier[]
  unitsOfMeasure      UnitOfMeasure[]
  recipes             Recipe[]
  wooIntegrations     WooIntegration[]
  menuItems           MenuItem[]
  menus               Menu[]
  orderViews          OrderView[]
  customers           Customer[]
  wooOrders           WooOrder[]
  giftCards           GiftCard[]
  timeClocks          TimeClock[]
  payPeriods          PayPeriod[]
  syncLogs            SyncLog[]
  staffVenues         StaffVenue[]
  menuItemVenues      MenuItemVenue[]
  bookings            Booking[]
  positions           Position[]
  pathways            Pathway[]
  services            Service[]
  apiKeys             ApiKey[]
}

model Department {
  id        String    @id @default(uuid())
  name      String
  venueId   String
  colour    String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  venue             Venue              @relation(fields: [venueId], references: [id])
  staff             Staff[]
  tasks             Task[]
  trainingModules   TrainingModule[]
  guides            Guide[]
  shifts            Shift[]
  notices           Notice[]
  sections          Section[]
  checklists        Checklist[]
  budgetCategories  BudgetCategory[]
  moduleDepartments ModuleDepartment[]
  linkedFrom        DepartmentLink[]   @relation("FromDepartment")
  linkedTo          DepartmentLink[]   @relation("ToDepartment")
  positions         Position[]
  pathways          Pathway[]
}

model DepartmentLink {
  id               String   @id @default(uuid())
  fromDepartmentId String
  toDepartmentId   String
  createdAt        DateTime @default(now())

  fromDepartment Department @relation("FromDepartment", fields: [fromDepartmentId], references: [id], onDelete: Cascade)
  toDepartment   Department @relation("ToDepartment", fields: [toDepartmentId], references: [id], onDelete: Cascade)

  @@unique([fromDepartmentId, toDepartmentId])
}

model Staff {
  id              String    @id @default(uuid())
  firstName       String
  lastName        String
  pin             String? // worker QR + PIN login (bcrypt). Optional: pure admins may have none.
  email           String?   @unique // admin/manager web login + cross-system match key
  password        String? // admin/manager web login (bcrypt)
  role            Role      @default(STAFF)
  venueId         String
  departmentId    String?
  profilePhotoUrl String?
  isActive        Boolean   @default(true)
  // --- External system links (one profile, many systems). Sync is "coming soon";
  //     these IDs let an admin link a person across systems now. ---
  swiftPosId      String? // SwiftPOS staff id
  myHrId          String? // MyHR id
  loadedReportsId String? // LoadedReports id
  hourlyRate      Float? // pay rate per hour
  employmentType  String? // FULL_TIME | PART_TIME | CASUAL
  defaultVenueId  String? // admin's preferred default venue across all modules
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  venue                Venue                @relation(fields: [venueId], references: [id])
  department           Department?          @relation(fields: [departmentId], references: [id])
  taskCompletions      TaskCompletion[]
  trainingAssignments  TrainingAssignment[]
  trainingCompletions  TrainingCompletion[]
  guideCompletions     GuideCompletion[]
  guideAssignments     GuideAssignment[]
  shiftNotes           ShiftNote[]
  shifts               Shift[]
  timeOffRequests      TimeOffRequest[]
  noticeAcks           NoticeAck[]
  sections             StaffSection[]
  followUps            FollowUp[]
  stocktakeCompletions StocktakeRecord[]    @relation("stocktakeCompletedBy")
  stocktakeAssignments StocktakeRecord[]    @relation("stocktakeAssignedTo")
  timeClocks           TimeClock[]
  payrollEntries       PayrollEntry[]
  staffVenues          StaffVenue[]
  maintenanceLogs      MaintenanceLog[]
  positions            StaffPosition[]
}

model Task {
  id                String         @id @default(uuid())
  title             String
  description       String?
  venueId           String
  departmentId      String?
  sectionId         String?
  assignedToStaffId String?
  completionType    CompletionType @default(TICK)
  scheduleType      ScheduleType   @default(DAILY)
  scheduleDays      Int[]
  customCron        String?
  intervalMonths    Int            @default(1) // MONTHLY: run every N months (anchored on createdAt month)
  monthlyOption     String? // MONTHLY: FIRST_DAY | LAST_DAY | FIFTEENTH | FIRST_WEEKDAY | LAST_WEEKDAY | FIRST_MONDAY | LAST_FRIDAY | SPECIFIC_DAY
  monthlyDay        Int? // MONTHLY + SPECIFIC_DAY: day of month (1-31, clamped)
  isActive          Boolean        @default(true)
  sortOrder         Int            @default(0)
  // One-off / side-work task
  isOneOff          Boolean        @default(false) // ad-hoc task (not recurring)
  dueDate           DateTime?      @db.Date // must be completed by this date
  rolloverEnabled   Boolean        @default(false) // if not done by dueDate, show again next day
  rolledOverFrom    DateTime?      @db.Date // if this is a rollover copy, the original date
  version           Int            @default(1) // bumped on a "significant change" (drives re-train)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  venue            Venue                  @relation(fields: [venueId], references: [id])
  department       Department?            @relation(fields: [departmentId], references: [id])
  section          Section?               @relation(fields: [sectionId], references: [id])
  taskCompletions  TaskCompletion[]
  trainingSteps    TrainingStep[]         @relation("StepLinkedTask")
  stepTasks        StepTask[]
  trainingModules  TrainingModule[]       @relation("ModuleLinkedTask")
  requiredTraining TaskRequiredTraining[]
  taskGuides       TaskGuide[]
  checklistLinks   ChecklistTask[]
  followUps        FollowUp[]
  moduleTasks      ModuleTask[]
}

model TaskCompletion {
  id            String   @id @default(uuid())
  taskId        String
  staffId       String
  completedAt   DateTime @default(now())
  note          String?
  photoUrl      String?
  scheduledDate DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  task  Task  @relation(fields: [taskId], references: [id])
  staff Staff @relation(fields: [staffId], references: [id])
}

model QRCode {
  id        String    @id @default(uuid())
  venueId   String
  label     String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  venue Venue @relation(fields: [venueId], references: [id])
}

// --- TASK TEMPLATES (Phase 2) ---

model TaskTemplate {
  id          String    @id @default(uuid())
  name        String // ALL CAPS, e.g. "BAR OPEN"
  description String?
  category    String? // grouping hint, e.g. "BAR", "KITCHEN", "FOH", "GENERAL"
  isBuiltIn   Boolean   @default(false) // seeded curated templates (not editable/deletable)
  venueId     String? // null = global/shared; else scoped to one venue
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  venue Venue?             @relation(fields: [venueId], references: [id])
  items TaskTemplateItem[]
}

model TaskTemplateItem {
  id             String         @id @default(uuid())
  templateId     String
  title          String // ALL CAPS
  description    String?
  completionType CompletionType @default(TICK)
  scheduleType   ScheduleType   @default(DAILY)
  scheduleDays   Int[]
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  template TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

// --- TRAINING (Phase 3) ---

model TrainingModule {
  id              String       @id @default(uuid())
  title           String // ALL CAPS
  description     String?
  category        String? // grouping, e.g. "BAR", "FOOD SAFETY"
  venueId         String
  departmentId    String? // if set, auto-applies to all staff in this department
  linkedTaskId    String? // if set, this guide is the how-to for a task
  kind            ResourceKind @default(TRAINING) // TRAINING (sign-off-able) | SOP | FAQ | HOWTO (reference)
  version         Int          @default(1) // bumped on a "significant change" (drives re-train)
  requiresSignOff Boolean      @default(false) // true = a manager must sign off; false = staff self-complete
  isOnboarding    Boolean      @default(false) // part of the onboarding checklist (applies to all staff)
  onboardingOrder Int          @default(0)
  isActive        Boolean      @default(true)
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  venue             Venue                  @relation(fields: [venueId], references: [id])
  department        Department?            @relation(fields: [departmentId], references: [id])
  linkedTask        Task?                  @relation("ModuleLinkedTask", fields: [linkedTaskId], references: [id])
  steps             TrainingStep[]
  assignments       TrainingAssignment[]
  completions       TrainingCompletion[]
  resourceSections  ResourceSection[]
  requiredByTasks   TaskRequiredTraining[]
  linksFrom         ResourceLink[]         @relation("ResourceLinkFrom")
  linksTo           ResourceLink[]         @relation("ResourceLinkTo")
  followUps         FollowUp[]
  moduleDepartments ModuleDepartment[]
  moduleTasks       ModuleTask[]
  stepModules       StepModule[]

  @@index([venueId])
}

model ModuleDepartment {
  id           String @id @default(uuid())
  moduleId     String
  departmentId String

  module     TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  department Department     @relation(fields: [departmentId], references: [id])

  @@unique([moduleId, departmentId])
}

model ModuleTask {
  id       String @id @default(uuid())
  moduleId String
  taskId   String

  module TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  task   Task           @relation(fields: [taskId], references: [id])

  @@unique([moduleId, taskId])
}

model TrainingStep {
  id                String   @id @default(uuid())
  moduleId          String
  order             Int
  title             String?
  content           String
  imageUrl          String? // uploaded photo
  videoUrl          String? // external video link (YouTube/Vimeo/etc)
  linkedTaskId      String?
  linkedChecklistId String? // embed a whole checklist into this step (tick off in person)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  module          TrainingModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  linkedTask      Task?               @relation("StepLinkedTask", fields: [linkedTaskId], references: [id])
  linkedChecklist Checklist?          @relation(fields: [linkedChecklistId], references: [id])
  stepTasks       StepTask[]
  stepModules     StepModule[]
  inventoryItems  StepInventoryItem[]
}

model StepInventoryItem {
  id        String   @id @default(uuid())
  stepId    String
  itemId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  step TrainingStep  @relation(fields: [stepId], references: [id], onDelete: Cascade)
  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([stepId, itemId])
  @@index([stepId])
  @@index([itemId])
}

// Many-to-many: step ↔ task
model StepTask {
  id     String @id @default(uuid())
  stepId String
  taskId String

  step TrainingStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  task Task         @relation(fields: [taskId], references: [id])

  @@unique([stepId, taskId])
}

// Many-to-many: step ↔ other training modules (for cross-linking SOPs, HOWTOs, etc.)
model StepModule {
  id       String @id @default(uuid())
  stepId   String
  moduleId String

  step   TrainingStep   @relation(fields: [stepId], references: [id], onDelete: Cascade)
  module TrainingModule @relation(fields: [moduleId], references: [id])

  @@unique([stepId, moduleId])
}

// Individual assignment of a module to a person (upskill / area to work on).
// Onboarding + department applicability is computed, not stored here.
model TrainingAssignment {
  id           String    @id @default(uuid())
  moduleId     String
  staffId      String
  assignedById String? // manager who assigned (Staff id, no relation)
  reason       String? // e.g. "UPSKILL", "AREA TO WORK ON"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  module TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  staff  Staff          @relation(fields: [staffId], references: [id])

  @@unique([moduleId, staffId])
}

model TrainingCompletion {
  id            String   @id @default(uuid())
  moduleId      String
  staffId       String
  completedAt   DateTime @default(now())
  selfCompleted Boolean  @default(false) // true = staff ticked it; false = manager sign-off
  signedOffById String? // manager who signed off (Staff id, no relation)
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  module TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  staff  Staff          @relation(fields: [staffId], references: [id])

  @@unique([moduleId, staffId])
}

// --- NOTICE BOARD ---

model Notice {
  id           String         @id @default(uuid())
  venueId      String
  departmentId String? // null = whole venue
  title        String
  body         String
  priority     NoticePriority @default(INFO)
  pinned       Boolean        @default(false)
  requiresAck  Boolean        @default(false)
  startsAt     DateTime? // active-window start (null = immediately)
  endsAt       DateTime? // active-window end (null = no expiry)
  isActive     Boolean        @default(true)
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  venue      Venue       @relation(fields: [venueId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  acks       NoticeAck[]
}

model NoticeAck {
  id       String   @id @default(uuid())
  noticeId String
  staffId  String
  ackedAt  DateTime @default(now())

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id])

  @@unique([noticeId, staffId])
}

// --- CALENDAR: roster + time off ---

// A rostered shift for a person on a date. Times are local "HH:mm" strings —
// a shift is "this calendar day, from start to end in venue-local time".
model Shift {
  id           String    @id @default(uuid())
  staffId      String
  venueId      String
  departmentId String?
  date         DateTime  @db.Date
  startTime    String // "09:00"
  endTime      String // "17:00"
  note         String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  staff      Staff       @relation(fields: [staffId], references: [id])
  venue      Venue       @relation(fields: [venueId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([venueId, date])
  @@index([staffId, date])
}

// An event imported from an external calendar feed (Google Calendar / any iCal).
// Keyed by (venueId, source, uid) so re-syncing UPDATES the same row instead of
// duplicating; events that vanish from the feed are soft-deleted on next sync.
model CalendarEvent {
  id            String         @id @default(uuid())
  venueId       String
  source        CalendarSource @default(ICAL)
  uid           String // stable id from the feed (per-occurrence for recurring)
  title         String
  description   String?
  location      String?
  startsAt      DateTime
  endsAt        DateTime?
  allDay        Boolean        @default(false)
  floorPlanSlug String? // links event to a specific floor plan layout
  floorPlanName String? // display name for the banner
  lastSyncedAt  DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  venue     Venue      @relation(fields: [venueId], references: [id])
  wooOrders WooOrder[]
  bookings  Booking[]

  @@unique([venueId, source, uid])
  @@index([venueId, startsAt])
}

model Booking {
  id              String        @id @default(uuid())
  venueId         String
  date            DateTime      @db.Date // venue-local calendar date
  startTime       String // "HH:mm" venue-local
  endTime         String // "HH:mm" venue-local
  partySize       Int
  contactName     String
  contactPhone    String?
  contactEmail    String?
  source          BookingSource @default(PHONE)
  status          BookingStatus @default(CONFIRMED)
  notes           String?
  calendarEventId String? // links to CalendarEvent for calendar display
  floorPlanSlug   String? // which floor plan layout this booking uses
  seatingSetupId  String? // FK to FloorPlanSetup for the generated table layout
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  venue         Venue          @relation(fields: [venueId], references: [id])
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id])
  tables        BookingTable[]
  orders        WooOrder[]

  @@index([venueId, date])
  @@index([venueId])
}

model BookingTable {
  id          String   @id @default(uuid())
  bookingId   String
  setupItemId String // FK to SetupItem (the table placed on the plan)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  setupItem SetupItem @relation(fields: [setupItemId], references: [id])

  @@unique([bookingId, setupItemId])
  @@index([bookingId])
  @@index([setupItemId])
}

model TimeOffRequest {
  id           String        @id @default(uuid())
  staffId      String
  venueId      String
  startDate    DateTime      @db.Date
  endDate      DateTime      @db.Date
  reason       String?
  status       TimeOffStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  staff Staff @relation(fields: [staffId], references: [id])
  venue Venue @relation(fields: [venueId], references: [id])

  @@index([venueId, status])
  @@index([staffId])
}

// ── TIME CLOCK + PAYROLL ──

// A single clock-in/out session (one shift's worth of actual time).
// A staff member can have at most one active session at a time (enforced via
// the API layer — not a DB constraint because Prisma doesn't support partial
// unique indexes).
model TimeClock {
  id          String    @id @default(uuid())
  staffId     String
  venueId     String
  clockIn     DateTime
  clockOut    DateTime? // null until punched out
  isActive    Boolean   @default(true)
  clockInLat  Float?
  clockInLon  Float?
  clockOutLat Float?
  clockOutLon Float?
  geoValid    Boolean   @default(true)
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  staff Staff @relation(fields: [staffId], references: [id])
  venue Venue @relation(fields: [venueId], references: [id])

  @@index([staffId, clockIn])
  @@index([venueId, clockIn])
  @@index([isActive])
}

// A pay cycle for a venue. Entries are calculated when the period is CLOSED.
model PayPeriod {
  id        String    @id @default(uuid())
  venueId   String
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  status    String    @default("OPEN") // OPEN | CLOSED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  venue   Venue          @relation(fields: [venueId], references: [id])
  entries PayrollEntry[]

  @@index([venueId, startDate])
}

// Per-staff calculated hours for one pay period. Created by the period-closing
// engine; re-closing a CLOSED period deletes old entries and recalculates.
model PayrollEntry {
  id          String    @id @default(uuid())
  payPeriodId String
  staffId     String
  totalHours  Float
  hourlyRate  Float
  totalPay    Float
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  payPeriod PayPeriod @relation(fields: [payPeriodId], references: [id])
  staff     Staff     @relation(fields: [staffId], references: [id])

  @@unique([payPeriodId, staffId])
}

// ── SHIFT NOTES ──

// Manager end-of-day notes about a person for a given shift date. An
// "AREA TO WORK ON" can be linked to a training module assigned to address it.
model ShiftNote {
  id             String    @id @default(uuid())
  staffId        String
  venueId        String
  authorId       String? // manager who wrote it (Staff id, no relation)
  shiftDate      DateTime  @db.Date
  category       String    @default("AREA TO WORK ON") // AREA TO WORK ON | PRAISE | INCIDENT | GENERAL
  content        String
  linkedModuleId String? // DEPRECATED — legacy TrainingModule. Use linkedGuideId.
  linkedGuideId  String? // guide assigned to address this
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  staff Staff @relation(fields: [staffId], references: [id])
  venue Venue @relation(fields: [venueId], references: [id])
}

model BudgetPeriod {
  id           String    @id @default(uuid())
  venueId      String
  year         Int
  month        Int // 1-12
  totalBudget  Float
  dailyWeights Json? // { mon, tue, wed, thu, fri, sat, sun } — each a number, sums to 100
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  venue      Venue            @relation(fields: [venueId], references: [id])
  categories BudgetCategory[]
  days       BudgetDay[]
  lines      BudgetLine[]

  @@unique([venueId, year, month])
}

model BudgetCategory {
  id             String    @id @default(uuid())
  budgetPeriodId String
  departmentId   String?
  name           String // ALL CAPS
  percentage     Float // e.g. 30.5
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  period      BudgetPeriod          @relation(fields: [budgetPeriodId], references: [id], onDelete: Cascade)
  department  Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  allocations BudgetDayAllocation[]
}

model BudgetDay {
  id             String   @id @default(uuid())
  budgetPeriodId String
  date           DateTime @db.Date
  isWorkingDay   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  period      BudgetPeriod          @relation(fields: [budgetPeriodId], references: [id], onDelete: Cascade)
  allocations BudgetDayAllocation[]

  @@unique([budgetPeriodId, date])
}

model BudgetDayAllocation {
  id               String   @id @default(uuid())
  budgetDayId      String
  budgetCategoryId String
  amount           Float
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  day      BudgetDay      @relation(fields: [budgetDayId], references: [id], onDelete: Cascade)
  category BudgetCategory @relation(fields: [budgetCategoryId], references: [id], onDelete: Cascade)

  @@unique([budgetDayId, budgetCategoryId])
}

// P&L budget lines — a separate layer from the %-breakdown. Per-period copies
// (one BudgetPeriod per venue/month), hierarchical via parentId, optionally
// linked to a Section for venue-wide rollups. TOTAL lines sum their children;
// GROUP lines are headers.
model BudgetLine {
  id             String         @id @default(uuid())
  budgetPeriodId String
  parentId       String? // self-FK — hierarchy
  sectionId      String? // links to Section (venue-wide rollup)
  name           String // ALL CAPS
  kind           BudgetLineKind @default(LINE)
  amount         Float? // LINE rows only; TOTAL = sum of children
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  period   BudgetPeriod @relation(fields: [budgetPeriodId], references: [id], onDelete: Cascade)
  parent   BudgetLine?  @relation("BudgetLineTree", fields: [parentId], references: [id], onDelete: Cascade)
  children BudgetLine[] @relation("BudgetLineTree")
  section  Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([budgetPeriodId])
  @@index([sectionId])
}

// --- CHECKLISTS (live task references — single source of truth) ---

// A named, ordered list of LIVE tasks (not copies). Editing a task updates it
// everywhere it appears. A task can belong to many checklists.
model Checklist {
  id             String    @id @default(uuid())
  name           String // ALL CAPS
  description    String?
  venueId        String
  departmentId   String?
  sectionId      String?
  appearFromTime String? // "HH:mm" venue-local — list shows from this time; stays until all done
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  venue         Venue           @relation(fields: [venueId], references: [id])
  department    Department?     @relation(fields: [departmentId], references: [id])
  section       Section?        @relation(fields: [sectionId], references: [id])
  tasks         ChecklistTask[]
  trainingSteps TrainingStep[]

  @@index([venueId])
}

model ChecklistTask {
  id          String   @id @default(uuid())
  checklistId String
  taskId      String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([checklistId, taskId])
}

// --- SECTION ECOSYSTEM (Phase A–D) ---

// A station within a department, e.g. Bar / Coffee / Cabinet under "Front of house".
// Venue → Department → Section. Tasks and resources can attach here.
model Section {
  id           String    @id @default(uuid())
  name         String // ALL CAPS
  venueId      String // denormalised from department for scoping
  departmentId String
  colour       String?
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  venue             Venue              @relation(fields: [venueId], references: [id])
  department        Department         @relation(fields: [departmentId], references: [id])
  tasks             Task[]
  staff             StaffSection[]
  resources         ResourceSection[]
  checklists        Checklist[]
  floorPlanElements FloorPlanElement[]
  boundaries        SectionBoundary[]
  setupItems        SetupItem[]
  storedItems       InventoryItem[]
  budgetLines       BudgetLine[]
  pathways          Pathway[]

  @@index([venueId])
  @@index([departmentId])
}

// Staff ⇄ Section (a person can work many sections).
model StaffSection {
  id        String   @id @default(uuid())
  staffId   String
  sectionId String
  createdAt DateTime @default(now())

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([staffId, sectionId])
}

model StaffVenue {
  id        String   @id @default(uuid())
  staffId   String
  venueId   String
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([staffId, venueId])
}

// A job title — distinct from Section, which is a place. "DUTY MANAGER" spans
// every section; "BARISTA" doesn't. departmentId is optional because roles like
// DUTY MANAGER cross departments.
model Position {
  id           String    @id @default(uuid())
  name         String // ALL CAPS
  venueId      String
  departmentId String?
  colour       String?
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  venue      Venue           @relation(fields: [venueId], references: [id])
  department Department?     @relation(fields: [departmentId], references: [id])
  staff      StaffPosition[]
  pathways   Pathway[]

  @@index([venueId])
}

// Staff ⇄ Position (a person can hold many roles — common in small venues where
// one person covers everything).
model StaffPosition {
  id         String   @id @default(uuid())
  staffId    String
  positionId String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([staffId, positionId])
}

// Resource ⇄ Section (a resource can be shared across many sections).
model ResourceSection {
  id        String   @id @default(uuid())
  moduleId  String
  sectionId String
  createdAt DateTime @default(now())

  module  TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  section Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([moduleId, sectionId])
}

// Resource ⇄ Resource cross-reference (a task's SOP → its training → its FAQ).
model ResourceLink {
  id           String   @id @default(uuid())
  fromModuleId String
  toModuleId   String
  createdAt    DateTime @default(now())

  fromModule TrainingModule @relation("ResourceLinkFrom", fields: [fromModuleId], references: [id], onDelete: Cascade)
  toModule   TrainingModule @relation("ResourceLinkTo", fields: [toModuleId], references: [id], onDelete: Cascade)

  @@unique([fromModuleId, toModuleId])
}

// Task ⇄ Training "requires" — the competency a person needs to do this task.
model TaskRequiredTraining {
  id        String   @id @default(uuid())
  taskId    String
  moduleId  String
  createdAt DateTime @default(now())

  task   Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  module TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([taskId, moduleId])
}

// A follow-up raised by the trigger engine for a manager to action.
model FollowUp {
  id           String         @id @default(uuid())
  venueId      String
  staffId      String
  taskId       String?
  moduleId     String? // DEPRECATED — legacy TrainingModule. Use guideId.
  guideId      String? // guide to do / that was missing
  kind         FollowUpKind
  status       FollowUpStatus @default(OPEN)
  detail       String?
  dueDate      DateTime?      @db.Date // the date the issue relates to (for MISSED)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  venue  Venue           @relation(fields: [venueId], references: [id])
  staff  Staff           @relation(fields: [staffId], references: [id])
  task   Task?           @relation(fields: [taskId], references: [id])
  module TrainingModule? @relation(fields: [moduleId], references: [id])
  guide  Guide?          @relation(fields: [guideId], references: [id])

  @@unique([venueId, staffId, kind, taskId, dueDate])
  @@index([venueId, status])
}

// --- PLAYBOOK GUIDES (Phase 6 — simplified replacement for TrainingModule) ---

model Guide {
  id              String      @id @default(uuid())
  title           String
  description     String?
  category        String?
  venueId         String
  departmentId    String?
  status          GuideStatus @default(DRAFT)
  isTracked       Boolean     @default(false)
  isOnboarding    Boolean     @default(false)
  requiresSignOff Boolean     @default(false)
  legacyToolsNote String?
  version         Int         @default(1) // bumped on a "significant change" (drives re-train)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  venue       Venue             @relation(fields: [venueId], references: [id])
  department  Department?       @relation(fields: [departmentId], references: [id])
  steps       GuideStep[]
  taskGuides  TaskGuide[]
  completions GuideCompletion[]
  assignments GuideAssignment[]
  followUps   FollowUp[]
  audiences   GuideAudience[]

  @@index([venueId])
  @@index([venueId, status])
}

model GuideStep {
  id        String   @id @default(uuid())
  guideId   String
  order     Int
  heading   String?
  content   String
  imageUrl  String?
  videoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guide Guide           @relation(fields: [guideId], references: [id], onDelete: Cascade)
  links GuideStepLink[]

  @@index([guideId])
}

model TaskGuide {
  id                      String   @id @default(uuid())
  taskId                  String
  guideId                 String
  isRequiredForCompetency Boolean  @default(false)
  createdAt               DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([taskId, guideId])
  @@index([guideId])
}

model GuideCompletion {
  id            String   @id @default(uuid())
  guideId       String
  staffId       String
  selfCompleted Boolean  @default(true)
  signedOffById String?
  completedAt   DateTime @default(now())
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([guideId, staffId])
  @@index([staffId])
}

// What a step points at. Replaces five separate junction tables on the legacy
// TrainingStep (StepInventoryItem, StepTask, StepModule, linkedTaskId,
// linkedChecklistId) with one row shape — so the editor has one "+ LINK" control
// and adding a new link type later is an enum value, not a migration.
//
// targetId is polymorphic, so there is no FK. lib/guide-links.ts batch-resolves
// per kind and marks a vanished target as missing rather than failing.
enum StepLinkKind {
  ITEM
  TASK
  CHECKLIST
  GUIDE
  SECTION
  RECIPE
}

model GuideStepLink {
  id        String       @id @default(uuid())
  stepId    String
  kind      StepLinkKind
  targetId  String
  qty       Int? // "2× T20 TORX"
  note      String? // "TOP SHELF, ABOVE THE GRINDER"
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  step GuideStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, kind, targetId])
  @@index([stepId])
}

// Who a guide auto-applies to. Replaces the single Guide.departmentId, which
// could only ever name one department and could not reach sections or roles.
// targetId is polymorphic on `kind` — no FK, so the resolver treats a missing
// target as "no longer applies" rather than failing.
model GuideAudience {
  id        String       @id @default(uuid())
  guideId   String
  kind      AudienceKind
  targetId  String
  createdAt DateTime     @default(now())

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, kind, targetId])
  @@index([guideId])
}

model GuideAssignment {
  id           String    @id @default(uuid())
  guideId      String
  staffId      String
  assignedById String?
  reason       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([guideId, staffId])
}

// --- PATHWAYS (the authored onboarding / progression tree) ---
//
// A pathway stores SHAPE only — which guides/tasks sit where, and what unlocks
// what. Progress is never stored here: a node reads DONE because a
// GuideCompletion / TaskCompletion already exists. That keeps one source of
// truth and stops a progress table growing by staff × node.

enum PathwayNodeKind {
  GUIDE
  TASK
  CHECKLIST
  MILESTONE // no target — a stage marker / reward the manager signs off
}

model Pathway {
  id           String      @id @default(uuid())
  name         String // ALL CAPS
  description  String?
  venueId      String
  departmentId String?
  sectionId    String?
  positionId   String?
  status       GuideStatus @default(DRAFT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  venue      Venue         @relation(fields: [venueId], references: [id])
  department Department?   @relation(fields: [departmentId], references: [id])
  section    Section?      @relation(fields: [sectionId], references: [id])
  position   Position?     @relation(fields: [positionId], references: [id])
  nodes      PathwayNode[]
  edges      PathwayEdge[]

  @@index([venueId])
  @@index([venueId, status])
}

model PathwayNode {
  id        String          @id @default(uuid())
  pathwayId String
  kind      PathwayNodeKind
  targetId  String? // null for MILESTONE
  label     String? // override / milestone text
  x         Float           @default(0)
  y         Float           @default(0)
  stage     Int             @default(0) // tier — drives the worker tree layout
  points    Int             @default(10)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  pathway   Pathway       @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  edgesFrom PathwayEdge[] @relation("PathwayEdgeFrom")
  edgesTo   PathwayEdge[] @relation("PathwayEdgeTo")

  @@index([pathwayId])
}

// "finish fromNode → unlocks toNode"
model PathwayEdge {
  id         String   @id @default(uuid())
  pathwayId  String
  fromNodeId String
  toNodeId   String
  createdAt  DateTime @default(now())

  pathway  Pathway     @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  fromNode PathwayNode @relation("PathwayEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   PathwayNode @relation("PathwayEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([pathwayId, fromNodeId, toNodeId])
  @@index([pathwayId])
}

// --- FLOOR PLANNER ---

enum ElementType {
  WALL
  DOOR
  WINDOW
  TABLE
  CHAIR
  COUNTER
  BAR
  BOOTH_BENCH
  KITCHEN_EQUIP
  SINK
  STORAGE
  ENTRY
  EXIT
  STAIRS
  TOILET
  PLANT
  OTHER
}

enum ElementShape {
  RECTANGLE
  CIRCLE
  POLYGON
}

enum BoundaryShape {
  RECTANGLE
  POLYGON
}

model FloorPlan {
  id        String    @id @default(uuid())
  venueId   String
  name      String
  slug      String
  isDefault Boolean   @default(false)
  roomWidth Float     @default(2000) // real-world cm
  roomDepth Float     @default(1500) // real-world cm
  gridUnit  Float     @default(50) // snap grid in cm
  zones     Json? // section zone rectangles [{id,x,y,w,h,sectionId}]
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  venue             Venue              @relation(fields: [venueId], references: [id])
  elements          FloorPlanElement[]
  setups            FloorPlanSetup[]
  sectionBoundaries SectionBoundary[]

  @@unique([venueId, slug])
  @@index([venueId])
}

model FloorPlanElement {
  id           String       @id @default(uuid())
  floorPlanId  String
  type         ElementType
  shape        ElementShape @default(RECTANGLE)
  label        String?
  labelVisible Boolean      @default(true)
  style        Json? // per-element style config (wallType, tableShape, etc.)
  // Position in real-world cm from room top-left
  x            Float
  y            Float
  width        Float        @default(80) // for RECTANGLE (cm)
  depth        Float        @default(80) // for RECTANGLE (cm)
  radius       Float? // for CIRCLE (cm)
  vertices     Json? // for POLYGON: [{x,y},...] relative to anchor
  rotation     Float        @default(0)
  // Appearance
  colour       String?
  fillColour   String?
  opacity      Float        @default(1)
  zIndex       Int          @default(0)
  // Business links
  sectionId    String?
  capacity     Int?
  chairCount   Int          @default(0)
  sortOrder    Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  floorPlan      FloorPlan              @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  section        Section?               @relation(fields: [sectionId], references: [id])
  inventoryItems ElementInventoryItem[]

  @@index([floorPlanId])
}

// ── LAYERED FLOOR PLANS ──

model FloorPlanSetup {
  id              String    @id @default(uuid())
  floorPlanId     String
  name            String
  /// Every floor plan has exactly one default layout: the venue's everyday
  /// arrangement. It owns the real table numbers, can't be deleted, and is what
  /// the venue reverts to when no event layout is active.
  isDefault       Boolean   @default(false)
  eventDate       DateTime? @db.Date
  calendarEventId String?
  notes           String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  floorPlan FloorPlan    @relation(fields: [floorPlanId], references: [id])
  items     SetupItem[]
  groups    TableGroup[]

  @@index([floorPlanId])
}

model SetupItem {
  id              String    @id @default(uuid())
  setupId         String
  /// Deprecated — superseded by furnitureItemId. Kept nullable so the furniture
  /// migration can read it after `db push`; drop once every deploy has migrated.
  tableProfileId  String?
  furnitureItemId String? // the InventoryItem this placement is an instance of
  x               Float
  y               Float
  rotation        Float     @default(0)
  sectionId       String?
  tableGroupId    String?
  assignedNumber  String?
  label           String?
  /// Deprecated — superseded by `chairs`. Per-edge counts can't express a chair
  /// sitting anywhere along a curved or polygonal outline.
  chairEdges      Json?
  chairs          Json? // ChairSlot[]: { id, t (0..1 around perimeter), offset, rotation }
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  setup         FloorPlanSetup @relation(fields: [setupId], references: [id], onDelete: Cascade)
  tableProfile  TableProfile?  @relation(fields: [tableProfileId], references: [id])
  furnitureItem InventoryItem? @relation(fields: [furnitureItemId], references: [id])
  section       Section?       @relation(fields: [sectionId], references: [id])
  tableGroup    TableGroup?    @relation(fields: [tableGroupId], references: [id])
  bookingLinks  BookingTable[]

  @@index([setupId])
  @@index([furnitureItemId])
}

model TableGroup {
  id        String    @id @default(uuid())
  setupId   String
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  setup FloorPlanSetup @relation(fields: [setupId], references: [id], onDelete: Cascade)
  items SetupItem[]

  @@index([setupId])
}

// ── TABLE PROFILE — DEPRECATED ──
// Superseded by furniture fields on InventoryItem + FurnitureBomItem. A table
// used to exist as both a TableProfile and an InventoryItem, joined only by
// matching name strings, so stock and geometry drifted apart.
//
// Still declared because `docker-entrypoint.sh` runs `prisma db push
// --accept-data-loss` BEFORE any migration script — removing these models here
// would drop the tables before `migrate-furniture.ts` could read them. Delete
// both models once every deployment has run the migration at least once.

model TableProfile {
  id             String    @id @default(uuid())
  venueId        String
  name           String
  type           String    @default("TABLE")
  capacity       Int       @default(0)
  width          Float
  depth          Float
  shape          String    @default("RECTANGLE")
  colour         String?   @default("#555")
  chairCount     Int       @default(0)
  seatingDensity Float?
  maxHeadChairs  Int       @default(1)
  tableNumbers   Json?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  venue    Venue              @relation(fields: [venueId], references: [id])
  bomItems TableProfileItem[]
  setups   SetupItem[]

  @@index([venueId])
}

model TableProfileItem {
  id              String   @id @default(uuid())
  tableProfileId  String
  inventoryItemId String
  quantity        Int      @default(1)
  perChair        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile TableProfile  @relation(fields: [tableProfileId], references: [id], onDelete: Cascade)
  item    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([tableProfileId, inventoryItemId])
  @@index([tableProfileId])
}

// ── SPATIAL SECTION BOUNDARY ──

model SectionBoundary {
  id          String        @id @default(uuid())
  floorPlanId String
  sectionId   String
  shape       BoundaryShape @default(RECTANGLE)
  x           Float
  y           Float
  width       Float?
  height      Float?
  vertices    Json?
  zIndex      Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  floorPlan FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  section   Section   @relation(fields: [sectionId], references: [id])

  @@index([floorPlanId])
  @@index([sectionId])
}

// --- INVENTORY & STOCKTAKE ---

enum StocktakeStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

// Where the order came from. WOO orders are owned by WooCommerce (status pushes
// back); MANUAL/PHONE orders are local-only and must never be pushed.
enum OrderSource {
  WOO
  MANUAL
  PHONE
}

enum FulfillmentType {
  DINE_IN
  PICKUP
  DELIVERY
}

// Operational lifecycle, deliberately separate from `OrderStatus` (which mirrors
// WooCommerce and is payment/store-centric). Not a strict linear machine — the
// relevant transitions depend on `fulfillmentType`, and the UI gates them.
enum OrderOpStatus {
  NEW
  CONFIRMED
  IN_PREP
  READY
  ARRIVED
  OUT_FOR_DELIVERY
  HANDED_OVER
  FINALISED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum GiftCardStatus {
  DRAFT
  ISSUED
  SENT
  REDEEMED
  VOIDED
  EXPIRED
}

enum SyncDirection {
  PULL
  PUSH
  WEBHOOK
}

enum SyncEntity {
  PRODUCT
  ORDER
}

enum SyncStatus {
  SUCCESS
  ERROR
  SKIPPED
}

enum KitchenStatus {
  PENDING
  COOKING
  READY
  SERVED
}

model InventoryCategory {
  id                  String    @id @default(uuid())
  venueId             String?
  name                String
  tab                 String?
  isBuiltIn           Boolean   @default(false)
  isActive            Boolean   @default(true)
  showDeepFields      Boolean   @default(false) // controls visibility of counting/ordering/cost/expiry/allergen fields
  showEquipmentFields Boolean   @default(false) // controls visibility of equipment/tool tracking section
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  venue         Venue?          @relation(fields: [venueId], references: [id])
  items         InventoryItem[]
  fallbackItems InventoryItem[] @relation("FallbackCategory")

  @@unique([venueId, name])
}

model InventoryItem {
  id                String    @id @default(uuid())
  venueId           String
  categoryId        String
  name              String
  unit              String    @default("EA")
  defaultParLevel   Int       @default(0)
  // --- Furniture fields (TABLES / furniture category items) ---
  // A furniture item is the SINGLE source of truth for a physical piece: what it
  // is, how many you own, its real footprint, and how it seats people. It
  // replaces the old TableProfile, which duplicated all of this and was joined
  // to inventory only by matching name strings.
  totalQty          Int       @default(0) // physical items owned, drives availableQty
  furnitureType     String? // "TABLE" | "CHAIR" | "BOOTH" | "SOFA" | "BAR" | "OTHER" | null
  elementWidth      Float? // cm — bounding box width
  elementDepth      Float? // cm — bounding box depth
  elementShape      String? // "RECTANGLE" | "CIRCLE" | "POLYGON"
  elementVertices   Json? // POLYGON outline [{x,y}] in cm, relative to the bounding box top-left
  defaultColour     String? // hex colour
  defaultChairCount Int       @default(0) // chairs this piece seats by default
  seatingDensity    Float? // cm of edge consumed per chair
  maxHeadChairs     Int       @default(1) // cap on chairs along a short (head) edge
  tableNumbers      Json? // string[] — physical table numbers this furniture can be assigned
  chairItemId       String? // which CHAIR furniture item seats this piece
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // --- Deep inventory fields ---
  supplierId           String?
  countingUnitId       String?
  countingUnitQty      Float?
  orderingUnitId       String?
  orderingUnitQty      Float?
  parLevelUnitId       String?
  yieldPercentage      Float?
  costPrice            Float?
  expiryDate           DateTime?
  fallbackCategoryId   String?
  // --- Food-specific shelf life ---
  shelfLifeDays        Int?
  canFreeze            Boolean   @default(false)
  freezerShelfLifeDays Int?

  allergyInfo String? // e.g. "GLUTEN, DAIRY, NUTS" for display on recipe ingredients

  // --- Equipment / tool tracking ---
  imageUrls              Json? // array of photo URLs
  storageSectionId       String? // FK to Section — where this item lives
  storageNotes           String? // e.g. "TOP SHELF, ABOVE THE COFFEE STATION"
  serialNumber           String?
  purchaseDate           DateTime?
  warrantyExpiry         DateTime?
  serviceIntervalDays    Int? // e.g. 180 = every 6 months; drives calendar bookings
  lastServicedAt         DateTime?
  nextServiceAt          DateTime?
  maintenanceNotes       String?
  alternativeSupplierIds Json? // array of supplier UUIDs

  venue             Venue                  @relation(fields: [venueId], references: [id])
  category          InventoryCategory      @relation(fields: [categoryId], references: [id])
  supplier          Supplier?              @relation(fields: [supplierId], references: [id])
  countingUnit      UnitOfMeasure?         @relation("CountingUOM", fields: [countingUnitId], references: [id])
  orderingUnit      UnitOfMeasure?         @relation("OrderingUOM", fields: [orderingUnitId], references: [id])
  parLevelUnit      UnitOfMeasure?         @relation("ParLevelUOM", fields: [parLevelUnitId], references: [id])
  fallbackCategory  InventoryCategory?     @relation("FallbackCategory", fields: [fallbackCategoryId], references: [id])
  storageSection    Section?               @relation(fields: [storageSectionId], references: [id])
  elements          ElementInventoryItem[]
  tableProfileItems TableProfileItem[]
  stocktake         StocktakeLineItem[]
  supplierCodes     SupplierItemCode[]
  recipeLineItems   RecipeLineItem[]
  stepLinks         StepInventoryItem[]
  maintenanceLogs   MaintenanceLog[]

  // --- Furniture relations ---
  chairItem       InventoryItem?     @relation("FurnitureChair", fields: [chairItemId], references: [id])
  seatsFurniture  InventoryItem[]    @relation("FurnitureChair")
  bomItems        FurnitureBomItem[] @relation("FurnitureBomParent")
  usedInFurniture FurnitureBomItem[] @relation("FurnitureBomChild")
  setupItems      SetupItem[]

  @@index([venueId])
  @@index([categoryId])
  @@index([chairItemId])
}

// Bill of materials for a furniture item: what has to be laid on / carried with
// each piece (linen, cutlery, glassware, candles...). Self-referential on
// InventoryItem — replaces TableProfileItem now that furniture lives in inventory.
model FurnitureBomItem {
  id              String   @id @default(uuid())
  furnitureItemId String // the table / booth / sofa
  inventoryItemId String // what goes on it
  quantity        Int      @default(1)
  perChair        Boolean  @default(false) // scales with seat count rather than per piece
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  furniture InventoryItem @relation("FurnitureBomParent", fields: [furnitureItemId], references: [id], onDelete: Cascade)
  item      InventoryItem @relation("FurnitureBomChild", fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([furnitureItemId, inventoryItemId])
  @@index([furnitureItemId])
}

model MaintenanceLog {
  id              String   @id @default(uuid())
  inventoryItemId String
  staffId         String?
  note            String
  createdAt       DateTime @default(now())

  item  InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  staff Staff?        @relation(fields: [staffId], references: [id])

  @@index([inventoryItemId])
}

model ElementInventoryItem {
  id        String   @id @default(uuid())
  elementId String
  itemId    String
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  element FloorPlanElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  item    InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([elementId, itemId])
  @@index([elementId])
  @@index([itemId])
}

model StocktakeRecord {
  id              String          @id @default(uuid())
  venueId         String
  date            DateTime        @db.Date
  status          StocktakeStatus @default(PENDING)
  assignedRoleId  String?
  assignedStaffId String?
  notes           String?
  completedById   String?
  completedAt     DateTime?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  venue         Venue               @relation(fields: [venueId], references: [id])
  completedBy   Staff?              @relation("stocktakeCompletedBy", fields: [completedById], references: [id])
  lineItems     StocktakeLineItem[]
  assignedStaff Staff?              @relation("stocktakeAssignedTo", fields: [assignedStaffId], references: [id])

  @@index([venueId])
  @@index([status])
  @@index([assignedStaffId])
}

model StocktakeLineItem {
  id               String   @id @default(uuid())
  recordId         String
  itemId           String
  countedQuantity  Int      @default(0)
  expectedQuantity Int      @default(0)
  variance         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  record StocktakeRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  item   InventoryItem   @relation(fields: [itemId], references: [id])

  @@unique([recordId, itemId])
  @@index([recordId])
}

model PaletteDefault {
  id         String  @id @default(uuid())
  venueId    String
  type       String
  width      Float
  depth      Float
  colour     String? @default("#555")
  chairCount Int     @default(0)

  venue Venue @relation(fields: [venueId], references: [id])

  @@unique([venueId, type])
  @@index([venueId])
}

// --- DEEP INVENTORY: SUPPLIERS & UOM ---

model Supplier {
  id        String    @id @default(uuid())
  venueId   String
  name      String
  contact   String?
  email     String?
  phone     String?
  notes     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  venue     Venue              @relation(fields: [venueId], references: [id])
  itemCodes SupplierItemCode[]
  items     InventoryItem[]

  @@index([venueId])
}

model UnitOfMeasure {
  id              String    @id @default(uuid())
  name            String
  baseUnit        String
  conversionRatio Float
  venueId         String?
  isBuiltIn       Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  venue             Venue?             @relation(fields: [venueId], references: [id])
  countingItems     InventoryItem[]    @relation("CountingUOM")
  orderingItems     InventoryItem[]    @relation("OrderingUOM")
  parLevelItems     InventoryItem[]    @relation("ParLevelUOM")
  recipeYields      Recipe[]           @relation("RecipeYield")
  recipeLineItems   RecipeLineItem[]
  supplierItemCodes SupplierItemCode[]

  @@unique([venueId, name])
  @@index([venueId])
}

model SupplierItemCode {
  id              String   @id @default(uuid())
  supplierId      String
  inventoryItemId String
  supplierSku     String
  purchasePrice   Float?
  orderingUnitId  String?
  isPreferred     Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  orderingUnit  UnitOfMeasure? @relation(fields: [orderingUnitId], references: [id])

  @@unique([supplierId, inventoryItemId])
  @@index([supplierId])
  @@index([inventoryItemId])
}

// --- RECIPE ENGINE (RECURSIVE BOM) ---

model Recipe {
  id           String    @id @default(uuid())
  venueId      String
  name         String
  yieldQty     Float
  yieldUnitId  String
  instructions String?
  prepTime     Int?
  isActive     Boolean   @default(true)
  version      Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  venue     Venue            @relation(fields: [venueId], references: [id])
  yieldUnit UnitOfMeasure    @relation("RecipeYield", fields: [yieldUnitId], references: [id])
  lineItems RecipeLineItem[] @relation("ParentRecipe")
  parentOf  RecipeLineItem[] @relation("ChildRecipe")
  menuItems MenuItem[]

  @@index([venueId])
}

model RecipeLineItem {
  id              String   @id @default(uuid())
  recipeId        String
  qty             Float
  uomId           String
  sortOrder       Int      @default(0)
  inventoryItemId String?
  childRecipeId   String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recipe        Recipe         @relation("ParentRecipe", fields: [recipeId], references: [id])
  uom           UnitOfMeasure  @relation(fields: [uomId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  childRecipe   Recipe?        @relation("ChildRecipe", fields: [childRecipeId], references: [id])

  @@index([recipeId])
  @@index([inventoryItemId])
  @@index([childRecipeId])
}

// --- WOOCOMMERCE & MENU MAPPING ---

model WooIntegration {
  id             String    @id @default(uuid())
  venueId        String
  storeUrl       String
  consumerKey    String
  consumerSecret String
  webhookSecret  String?
  // Maps WooCommerce `meta_data` keys onto our order fields. Necessary because
  // date/party-size plugins expose their value under a key derived from the
  // field label configured inside the plugin — a hardcoded key breaks the
  // moment someone renames a field. Shape: `{ serviceDate: string[], ... }`,
  // each an ordered list of candidate keys. Null = use DEFAULT_META_MAP.
  metaFieldMap   Json?
  lastSyncAt     DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  venue Venue @relation(fields: [venueId], references: [id])

  @@unique([venueId])
}

model MenuItem {
  id               String    @id @default(uuid())
  venueId          String
  name             String
  recipeId         String?
  price            Float     @default(0)
  wooProductId     String?   @unique
  wooCategoryId    String?
  imageUrl         String?
  description      String?
  shortDescription String?
  isVariable       Boolean   @default(false)
  variations       Json?
  dietaryInfo      String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  venue       Venue           @relation(fields: [venueId], references: [id])
  recipe      Recipe?         @relation(fields: [recipeId], references: [id])
  orderItems  WooOrderItem[]
  venueShares MenuItemVenue[]
  menuLinks   MenuMenuItem[]

  @@index([venueId])
  @@index([wooProductId])
}

model MenuItemVenue {
  id            String   @id @default(uuid())
  menuItemId    String
  venueId       String
  priceOverride Float? // venue-specific price (null = use menuItem.price)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  venue    Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, venueId])
  @@index([venueId])
}

// --- MENUS ---

// A named, orderable menu — "FRIDAY NIGHT BISTRO", "EVENT CATERING". Groups
// existing MenuItems and carries the ordering rules for them. A MenuItem can
// appear on several menus with different limits on each.
model Menu {
  id          String    @id @default(uuid())
  venueId     String
  name        String
  description String?
  // Headcount range the menu is offered for (e.g. catering from 20 to 150).
  // Null on either side means unbounded in that direction.
  minPax      Int?
  maxPax      Int?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  venue  Venue          @relation(fields: [venueId], references: [id])
  items  MenuMenuItem[]
  orders WooOrder[]

  @@unique([venueId, name])
  @@index([venueId])
}

model MenuMenuItem {
  id         String   @id @default(uuid())
  menuId     String
  menuItemId String
  // Per-item quantity limits, applied when the item is ordered at all.
  // minQty does NOT force the item onto every order — it is the minimum you
  // must take *if* you take any (e.g. a platter that only serves 20+).
  minQty     Int?
  maxQty     Int?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  menu     Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuId, menuItemId])
  @@index([menuId])
  @@index([menuItemId])
}

// A named filter/grouping preset on the orders page. The renderer is fixed
// (`viewType`); everything the user can bend — filters, grouping, visible
// columns — lives in `config` so adding a control needs no migration.
model OrderView {
  id          String    @id @default(uuid())
  venueId     String
  name        String
  viewType    String // SERVICE | KITCHEN | FOH | PRODUCTION
  config      Json
  isShared    Boolean   @default(true) // false = only the creator sees it
  createdById String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  venue Venue @relation(fields: [venueId], references: [id])

  @@index([venueId])
}

// --- SERVICES (dated ordering) ---

// A dated ordering service — "FRIDAY MENU". Declares which Woo category its
// menu comes from and when orders are taken (weekly `ServiceSlot` rules plus
// one-off `ServiceException` dates). The WooCommerce plugin renders these as
// the checkout options; the app is the single source of truth for the schedule.
model Service {
  id              String    @id @default(uuid())
  venueId         String
  name            String // "FRIDAY MENU"
  description     String?
  wooCategoryId   String? // numeric Woo category id — the menu for this service
  wooCategoryName String? // denormalised for display in the plugin
  requiresBooking Boolean   @default(false) // book-a-table mandatory for this service
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  venue      Venue              @relation(fields: [venueId], references: [id])
  slots      ServiceSlot[]
  exceptions ServiceException[]
  orders     WooOrder[]

  @@index([venueId])
}

// One weekly time window for a service. dayOfWeek 0=Sun..6=Sat (same convention
// as scheduleDays). `maxCovers` caps how many people (covers) a slot accepts,
// counting the party sizes of orders + bookings in the slot.
model ServiceSlot {
  id        String @id @default(uuid())
  serviceId String
  dayOfWeek Int // 0=Sun .. 6=Sat
  startTime String // "HH:mm" venue-local
  endTime   String // "HH:mm" venue-local
  maxCovers Int    @default(10)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, dayOfWeek, startTime])
  @@index([serviceId])
}

// One-off schedule override for a service — a specific date either closed
// (no orders taken) or running with its own slots instead of the weekly rule.
model ServiceException {
  id        String   @id @default(uuid())
  serviceId String
  date      DateTime @db.Date
  closed    Boolean  @default(false)
  // When open with overrides: custom slot window for this date (else the
  // weekly rule applies). "HH:mm" venue-local.
  startTime String?
  endTime   String?
  maxCovers Int?

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, date])
  @@index([serviceId])
}

// Venue-scoped API keys for the public API (WooCommerce plugin + booking-only
// widgets). The raw key is shown once at creation; only the hash is stored.
model ApiKey {
  id         String    @id @default(uuid())
  venueId    String
  name       String // label, e.g. "WEBSITE PLUGIN"
  keyHash    String // sha256 of the raw key
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  venue Venue @relation(fields: [venueId], references: [id])

  @@index([venueId])
}

// --- CUSTOMERS ---

// One row per real person, per venue. Orders and (later) bookings link here so
// the same customer arriving via WooCommerce, phone, and the booking form does
// not become three records. Matching lives in `lib/customer-match.ts`.
model Customer {
  id        String    @id @default(uuid())
  venueId   String
  name      String
  email     String?
  phone     String?
  // Normalised match keys, derived on write: lowercased/trimmed email and
  // digits-only phone. Indexed so dedupe lookups are a single query.
  emailKey  String?
  phoneKey  String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  venue  Venue      @relation(fields: [venueId], references: [id])
  orders WooOrder[]

  // Email is a strong identity — enforced at the DB so a duplicate is impossible.
  // Phone is only indexed, not unique: households legitimately share a landline,
  // so it is a matching heuristic rather than a constraint.
  @@unique([venueId, emailKey])
  @@index([venueId])
  @@index([venueId, phoneKey])
}

// --- ORDERS & AUTO-SEATING ---

model WooOrder {
  id              String          @id @default(uuid())
  venueId         String
  // Null for MANUAL/PHONE orders — only WooCommerce-sourced orders carry one.
  wooOrderId      String?         @unique
  source          OrderSource     @default(WOO)
  orderNumber     String? // local reference for orders raised in-app
  // Denormalised contact details as they arrived on the order. `customerId` is
  // the deduped link; these stay as the point-in-time record.
  customerId      String?
  menuId          String? // which menu this order was placed against
  serviceId       String? // which dated Service this order was placed for
  bookTable       Boolean         @default(false) // customer chose "book a table too"
  // Set when a pre-order is matched to a table reservation, so the order shows
  // against the booked table rather than an auto-seated one of its own.
  bookingId       String?
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  partySize       Int?
  fulfillmentDate DateTime? // legacy — superseded by serviceDate/serviceTime
  serviceDate     DateTime?       @db.Date // the date the order is FOR (venue-local)
  serviceTime     String? // "HH:mm" venue-local
  fulfillmentType FulfillmentType @default(DINE_IN)
  status          OrderStatus     @default(PENDING) // mirrors WooCommerce
  opStatus        OrderOpStatus   @default(NEW) // our operational lifecycle
  paymentStatus   PaymentStatus   @default(UNPAID)
  paymentMethod   String? // e.g. Woo's payment_method_title
  paidAt          DateTime?
  arrivedAt       DateTime?
  deliveredAt     DateTime?
  finalisedAt     DateTime?
  totalAmount     Float?
  notes           String?
  allergenNote    String? // order-level allergy note from the Woo checkout
  calendarEventId String?
  syncedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  venue         Venue          @relation(fields: [venueId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  menu          Menu?          @relation(fields: [menuId], references: [id])
  service       Service?       @relation(fields: [serviceId], references: [id])
  booking       Booking?       @relation(fields: [bookingId], references: [id])
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id])
  items         WooOrderItem[]
  giftCards     GiftCard[]

  @@unique([venueId, orderNumber])
  @@index([venueId])
  @@index([wooOrderId])
  @@index([status])
  @@index([calendarEventId])
  @@index([customerId])
  @@index([venueId, serviceDate])
}

model WooOrderItem {
  id                  String        @id @default(uuid())
  orderId             String
  menuItemId          String
  qty                 Int           @default(1)
  unitPrice           Float?
  // `notes` historically held BOTH the Woo line-item name and the exploded-recipe
  // JSON blob. Those are now split out into productName/explodedIngredients so
  // notes is free for genuine operator notes.
  notes               String?
  productName         String? // line-item name exactly as it was ordered
  explodedIngredients Json? // recursive recipe BOM result for this line
  customerNote        String? // customer request against this line
  allergenNote        String? // allergy requirement for this line — kitchen alert
  kitchenStatus       KitchenStatus @default(PENDING)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  order    WooOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@index([menuItemId])
}

model GiftCard {
  id            String         @id @default(uuid())
  venueId       String
  number        String         @unique
  amount        Float
  customerName  String?
  customerEmail String?
  message       String?
  status        GiftCardStatus @default(DRAFT)
  isInternal    Boolean        @default(false)
  wooOrderId    String?
  issuedAt      DateTime?
  sentAt        DateTime?
  expiresAt     DateTime?
  pdfPath       String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  venue    Venue     @relation(fields: [venueId], references: [id])
  wooOrder WooOrder? @relation(fields: [wooOrderId], references: [id])

  @@index([venueId])
  @@index([number])
  @@index([status])
}

// --- WOOCOMMERCE SYNC LOG ---

model SyncLog {
  id         String        @id @default(uuid())
  venueId    String?
  direction  SyncDirection
  entity     SyncEntity
  status     SyncStatus
  externalId String?
  message    String
  detail     Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  venue Venue? @relation(fields: [venueId], references: [id])

  @@index([venueId])
  @@index([createdAt])
  @@index([status])
}
