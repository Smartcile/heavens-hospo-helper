{
  "name": "@hospo-ops/web",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node ../../scripts/bump-version.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "type-check": "tsc --noEmit",
    "db:generate": "cd ../../packages/db && prisma generate",
    "db:migrate": "cd ../../packages/db && prisma migrate deploy",
    "db:migrate:dev": "cd ../../packages/db && prisma migrate dev",
    "db:seed": "cd ../../packages/db && npm run db:seed",
    "db:reset": "cd ../../packages/db && prisma migrate reset --force"
  },
  "dependencies": {
    "@hospo-ops/db": "*",
    "@hospo-ops/types": "*",
    "@xyflow/react": "^12.11.2",
    "bcryptjs": "^2.4.3",
    "cron-parser": "^4.9.0",
    "jose": "^5.3.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.0",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "read-excel-file": "^5.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@hospo-ops/config": "*",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
