# ── Local development env ────────────────────────────────────────────
# Copy to apps/web/.env.local and adjust. For Docker deploys use the root
# .env.example instead (the compose file builds DATABASE_URL for you).

# ── Database ─────────────────────────────────────────────────────────
# Matches the Postgres container in DEV-SETUP.md
# (docker run ... -e POSTGRES_PASSWORD=hospo123 -e POSTGRES_DB=hospo_ops).
DATABASE_URL=postgresql://postgres:hospo123@localhost:5432/hospo_ops

# ── Secrets (any non-empty string is fine for local dev) ─────────────
NEXTAUTH_SECRET=dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000
WORKER_SESSION_SECRET=dev-worker-secret-change-in-production
WORKER_SESSION_EXPIRY_MINUTES=15

# ── App ──────────────────────────────────────────────────────────────
APP_NAME=HOSPO OPS
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HOSPO OPS
NEXT_PUBLIC_WORKER_SESSION_EXPIRY_MINUTES=15

# ── Uploads (Phase 1: local disk) ────────────────────────────────────
UPLOAD_PROVIDER=local
UPLOAD_PATH=./public/uploads

# ── Cron jobs ─────────────────────────────────────────────────────────
# Internal scheduler (Woo product sync every 15 min + daily expiry scan)
# runs automatically. Set INTERNAL_CRON=false to disable it in dev.
INTERNAL_CRON=true
# Bearer token for manual /api/cron/* triggers (optional)
CRON_SECRET=
