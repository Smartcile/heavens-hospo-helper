# ── Docker / compose env ─────────────────────────────────────────────
# Copy to .env for `docker compose` (or paste these into Portainer's stack
# env). The compose file builds DATABASE_URL and derives NEXTAUTH_URL from
# APP_URL, so you only set the values below. For local dev (no Docker) use
# apps/web/.env.local.example instead.

# ── Instance identity ────────────────────────────────────────────────
# Change INSTANCE_NAME to run multiple copies of the app side-by-side.
# Container names become ${INSTANCE_NAME}-app and ${INSTANCE_NAME}-db.
# In Portainer each stack must have a unique INSTANCE_NAME.
INSTANCE_NAME=hospo-ops

# ── Database ────────────────────────────────────────────────────────
DB_USER=hospo_ops_user
DB_PASSWORD=change_me_to_something_strong

# ── Storage (bind mount or named volume) ─────────────────────────────
# Leave these as the default to use Docker named volumes (auto-scoped
# per stack in Portainer — no conflicts). Set them to an absolute host
# path (e.g. /mnt/data/hospo-db) to use a bind mount instead.
DB_DATA=postgres_data
UPLOADS_DATA=uploads_data

# ── Secrets ──────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_generated_secret

# ── App ─────────────────────────────────────────────────────────────
APP_NAME=HOSPO OPS
# The ONE public URL you reach the app at — drives admin login AND the QR codes
# staff scan, so it must be reachable from their devices. Include the port if
# it isn't 80/443.
#   LAN:               http://192.168.1.100:9008
#   Cloudflare Tunnel: https://hospo.yourdomain.com   (no port needed)
APP_URL=http://your-server-ip:9008
# Host port the app is published on. Container always listens on 3000 internally.
# Not needed if you reach the app only through a Cloudflare Tunnel.
APP_PORT=9008

# ── Worker session ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
WORKER_SESSION_SECRET=replace_with_another_generated_secret
WORKER_SESSION_EXPIRY_MINUTES=15

# ── Cron jobs ─────────────────────────────────────────────────────────
# The app runs its own internal scheduler (WooCommerce product sync every
# 15 min + daily expiry scan) — no host crontab needed. Set to false only
# if you prefer an external scheduler hitting the /api/cron/* endpoints.
INTERNAL_CRON=true
# Bearer token for the /api/cron/* endpoints (optional — only needed for
# external schedulers or manual curl triggers). openssl rand -base64 32
CRON_SECRET=

# ── Email / SMTP (optional — needed to email gift cards) ──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_password
SMTP_FROM=noreply@example.com
